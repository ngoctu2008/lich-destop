<Application x:Class="LichDeBan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             Startup="Application_Startup"
             Exit="Application_Exit">
    <Application.Resources>
        <!-- Khai báo Tray Icon -->
        <tb:TaskbarIcon x:Key="MyNotifyIcon"
                        IconSource="pack://application:,,,/Resources/icon.ico"
                        ToolTipText="Lịch Để Bàn"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Khóa/Mở khóa vị trí" Click="ToggleLock_Click" />
                    <MenuItem Header="Cài đặt" Click="Settings_Click" />
                    <Separator />
                    <MenuItem Header="Thoát" Click="Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>