<Window x:Class="LichDeBan.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa ghi chú"
        Height="200" Width="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
    <Border Background="#EE222222" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="5" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DateText" Grid.Row="0" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBox x:Name="NoteTextBox" Grid.Row="1"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     Background="#33FFFFFF" Foreground="White" BorderBrush="Transparent"
                     Padding="5" VerticalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Hủy" Click="Cancel_Click" Width="60" Margin="0,0,10,0"
                        Background="#55FFFFFF" Foreground="White" BorderBrush="Transparent"/>
                <Button Content="Lưu" Click="Save_Click" Width="60"
                        Background="#28a745" Foreground="White" BorderBrush="Transparent"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>