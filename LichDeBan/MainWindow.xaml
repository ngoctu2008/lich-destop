<Window x:Class="LichDeBan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LichDeBan.ViewModels"
        mc:Ignorable="d"
        Title="Lịch Để Bàn"
        Height="500" Width="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border x:Name="MainBorder"
            Background="#33FFFFFF"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="8"
            Padding="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Các ngày trong tuần -->
                <RowDefinition Height="*"/>    <!-- Lưới lịch -->
            </Grid.RowDefinitions>

            <!-- Header (Tháng, Năm và nút chuyển) -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&lt;" Width="30" Height="30" Click="PreviousMonth_Click"
                        Background="Transparent" Foreground="White" BorderBrush="White" FontSize="16"/>

                <TextBlock Grid.Column="1" Text="{Binding MonthYearText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontSize="20" FontWeight="Bold"/>

                <Button Grid.Column="2" Content="&gt;" Width="30" Height="30" Click="NextMonth_Click"
                        Background="Transparent" Foreground="White" BorderBrush="White" FontSize="16"/>
            </Grid>

            <!-- Headers Ngày trong tuần -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,5">
                <TextBlock Text="T2" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="T3" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="T4" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="T5" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="T6" TextAlignment="Center" Foreground="White" FontWeight="Bold"/>
                <TextBlock Text="T7" TextAlignment="Center" Foreground="#FFCC00" FontWeight="Bold"/>
                <TextBlock Text="CN" TextAlignment="Center" Foreground="#FF3333" FontWeight="Bold"/>
            </UniformGrid>

            <!-- Lưới Lịch -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#44FFFFFF" BorderThickness="0.5" Background="Transparent"
                                Margin="2" CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Background" Value="#4400FF00"/>
                                            <Setter Property="BorderBrush" Value="#8800FF00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Khu vực Ngày -->
                                <Grid Grid.Row="0">
                                    <!-- Ngày Dương -->
                                    <TextBlock Text="{Binding SolarDay}"
                                               FontSize="18" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- Ngày Âm -->
                                    <TextBlock Text="{Binding LunarDayText}"
                                               FontSize="11" Foreground="#FFAA00"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                </Grid>

                                <!-- Khu vực Ghi chú -->
                                <TextBlock Grid.Row="1" Text="{Binding Notes}"
                                           Foreground="#DDFFFFFF" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           VerticalAlignment="Top" MaxHeight="40"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</Window>